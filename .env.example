# ===========================================
# Tirumala Mutual Fund Services (TMFS)
# Environment Variables Specification
# ===========================================

# 1. Database (Neon Postgres Pooled Connection)
DATABASE_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Auth.js / NextAuth v5 Configuration
AUTH_SECRET="your-nextauth-secret-key-32-chars-minimum"
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
ADMIN_EMAILS="admin@example.com"
ADVISOR_EMAILS="advisor@example.com"

# 3. Cache & Rate-Limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# 4. Transactional Email (Resend)
RESEND_API_KEY="re_123456789_your_resend_api_key"
LEAD_NOTIFICATION_EMAIL="leads@example.com"

# 5. Site & General Configuration
NEXT_PUBLIC_SITE_URL="https://tirumalamutualfunds.in"
NEXT_PUBLIC_SITE_NAME="Tirumala Mutual Fund Services"
NEXT_PUBLIC_WHATSAPP_NUMBER="918763732389"
